# Local fixture mode runs without backend credentials.
NEXT_PUBLIC_DATA_MODE=demo

# Required when NEXT_PUBLIC_DATA_MODE=convex. Use values from your deployment.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# CLI/build-only secrets. Never use NEXT_PUBLIC_ for these.
# Store the appropriate deploy key in Netlify's context-scoped secret settings.
CONVEX_DEPLOY_KEY=

# Set these in Convex environment settings, not in the frontend:
# SITE_URL=https://your-configured-frontend-domain
# BETTER_AUTH_SECRET=<generated-secret-at-least-32-characters>
# GOOGLE_CLIENT_ID=<from-Google>
# GOOGLE_CLIENT_SECRET=<from-Google>
# MICROSOFT_CLIENT_ID=<from-Microsoft>
# MICROSOFT_CLIENT_SECRET=<from-Microsoft>
# MICROSOFT_TENANT_ID=common
# DEPLOYMENT_ENV=development|preview|production
# ALLOW_SYNTHETIC_SEED=false
# INITIAL_ACCOUNT_EMAIL=<private-initial-account-email>
# INITIAL_ACCOUNT_PASSWORD=<unique-strong-password-12-to-128-characters>
# Remove both INITIAL_ACCOUNT variables after CLI provisioning.
# GOOGLE_OPEN_ACCESS_ORGANIZATION_ID=<explicit-synthetic-demo-organization-id>
# Optional: auto-enroll authenticated Google users as demo viewers; no stock/admin rights.
