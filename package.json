{
  "name": "loom-inventory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "tsx scripts/prepare-public-assets.ts && next build --webpack",
    "predev": "tsx scripts/prepare-public-assets.ts",
    "convex:dev": "convex dev",
    "seed:convex": "tsx scripts/seed-convex.ts",
    "check:environment": "tsx scripts/validate-environment.ts",
    "deploy:netlify": "tsx scripts/build-deployment.ts",
    "start": "next start --hostname 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "python3 scripts/generate_mock.py",
    "seed:database": "python3 scripts/export_database_seed.py",
    "contract:api": "python3 scripts/build_api_contract.py",
    "check:contracts": "python3 -m unittest discover -s tests -p 'test_data_contracts.py'",
    "check:data": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "format": "prettier --write app components lib tests/*.ts docs/*.md README.md"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.6.33",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.46.0",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.60",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "^16.3.8",
    "@rolldown/binding-darwin-arm64": "^1.2.12",
    "@tailwindcss/oxide-darwin-arm64": "^4.3.3"
  }
}
